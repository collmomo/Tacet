{
  "name": "tacet",
  "version": "0.1.0",
  "description": "A way to build a screen with plain classes. Nothing moves unless you marked it.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
