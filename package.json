{
  "name": "tacet",
  "version": "0.1.0",
  "description": "A way to build a screen with plain classes. Nothing moves unless you marked it.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check": "vue-tsc --noEmit",
    "bench": "BENCH=1 NODE_OPTIONS=\"--expose-gc --max-old-space-size=12288\" vitest run bench --pool=forks --no-file-parallelism",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-core": "^3.5.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "magic-string": "^0.30.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-core": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
