{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "vueCompilerOptions": {"extensions": [".vue", ".tacet"]},
  "include": ["Good.ts", "Good.tacet"]
}
